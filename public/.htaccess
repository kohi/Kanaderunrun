# ============================================================
# Kanaderu (カナデル) - さくらのレンタルサーバ向け .htaccess 設定
# ============================================================

<IfModule mod_rewrite.c>
  RewriteEngine On

  # 1. 常時 SSL (HTTPS) 化リダイレクト
  # WebCodecs や Web Audio API などの最新ブラウザ機能には HTTPS が必須です
  RewriteCond %{HTTPS} off
  RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]
</IfModule>

# 2. MIME タイプの明示
<IfModule mod_mime.c>
  AddType text/javascript .js .mjs
  AddType text/css .css
  AddType image/svg+xml .svg
  AddType image/webp .webp
  AddType video/mp4 .mp4
  AddType application/wasm .wasm
</IfModule>

# 3. Gzip 圧縮による転送高速化
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css
  AddOutputFilterByType DEFLATE text/javascript application/javascript application/x-javascript
  AddOutputFilterByType DEFLATE image/svg+xml application/json
</IfModule>

# 4. ブラウザキャッシュ設定（ハッシュ付き静的アセットの高速化）
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
</IfModule>
